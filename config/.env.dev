# Shared development environment. No secrets here: accounts go in config/.env.dev.secrets (Admin/Identity users)
# and config/.env.dev.app.secrets (host app users), both git-ignored. Copy config/.env.example to create them.

# Admin: the Angular app (quarryconnect-admin-ui) on top of the Admin API (quarryconnect-admin-ui src/environments/environment.ts).
ADMIN_URL=https://admin-dev.quarryconnect.com
ADMIN_API_URL=https://admin-api-dev.quarryconnect.com
IDENTITY_URL=https://id-dev.quarryconnect.com
# The dev host as it is named in HOST_MASTER (Admin > Hosts): host key "default", client host.dev.
HOST_NAME=QuarryConnect (dev)
IGNORE_HTTPS_ERRORS=false

# The host app (quarryconnect-ui, deploy-develop.yml) and its API. Sign-in uses APP_ADMIN_EMAIL / APP_ADMIN_PASSWORD
# from config/.env.dev.app.secrets; the app tests are skipped without them.
APP_URL=https://dev.quarryconnect.com
APP_API_URL=https://devapi.quarryconnect.com
# The host's EnvironmentSetting TimeZoneSettings:TimeZoneId ("Central Standard Time").
APP_TIME_ZONE=America/Chicago

# The drivers API and Driver UI. Since QC-775 the driver clients are platform clients in Identity.
DRIVERS_API_URL=https://drivers-api-dev.quarryconnect.com
MOBILE_CLIENT_ID=drivers.mobile
# The dev host's Identity client (quarryconnect-ui src/oidc/production/config.js, QC775_dev_server_deploy.sql HostClientId).
# The redirect URI must match one of its app.HostAllowedUrls return addresses exactly; the tests catch the redirect.
HOST_CLIENT_ID=host.dev
HOST_REDIRECT_URI=https://dev.quarryconnect.com/
DRIVER_UI_CLIENT_ID=drivers-web
DRIVER_UI_REDIRECT_URI=https://drivers-dev.quarryconnect.com/
# Identity's Landing:PublicUrl.
LANDING_URL=https://www.quarryconnect.com/
# Identity's administration service client (QC-738). Its secret, ADMIN_API_CLIENT_SECRET, goes in .env.dev.secrets.
ADMIN_API_CLIENT_ID=identity.admin.service

# No database, log-folder, LocalStack or Expo-stub settings: those cases are local-only and skip on dev.

# Dev is shared: read-only by default. Opt in per run with ALLOW_WRITES=true.
ALLOW_WRITES=false
ALLOW_CREATE_HOSTS=false
ALLOW_RESTART=false
