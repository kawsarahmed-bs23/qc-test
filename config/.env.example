# Copy to env/<env>.secrets.env (local.secrets.env, dev.secrets.env, prod.secrets.env). Those files are git-ignored.
# In CI, set the same names as pipeline secrets instead.

# A dedicated Identity test account, never a person's account. Locally (QC-775) the run seeds a throwaway HOST_MASTER platform
# admin with two-step verification that copies this password; elsewhere this account must be a platform admin with two-step verification.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: a user with a non-admin role (e.g. Driver). The permission-denied tests are skipped without it.
DRIVER_EMAIL=
DRIVER_PASSWORD=

# Optional: the secret of Identity's administration service client (ADMIN_API_CLIENT_ID). The IDADMIN tests are skipped without it.
ADMIN_API_CLIENT_SECRET=

# Optional (local, QC-914): the private JWKs (one-line JSON) the INV cases sign Host invite links with. INVITE_TEST_HOST_PRIVATE_JWK
# is the test key whose public half the QC-914 Identity has for the host client HOST_CLIENT_ID; INVITE_TEST_WRONG_PRIVATE_JWK is a key
# Identity does not know. The INV tests are skipped without them.
INVITE_TEST_HOST_PRIVATE_JWK=
INVITE_TEST_WRONG_PRIVATE_JWK=
