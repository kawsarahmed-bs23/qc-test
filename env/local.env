# Local developer machine. Identity, Admin and (optionally) the host API run on localhost.
# Admin is the Angular app (quarryconnect-admin-ui, `npm start` on 4400) on top of the Admin API (QC-742).
ADMIN_URL=http://localhost:4400
ADMIN_API_URL=https://localhost:7090
IDENTITY_URL=https://localhost:7050
HOST_NAME=Rock Ridge Transport (local)
IGNORE_HTTPS_ERRORS=true

# The host app (quarryconnect-ui). Its sign-in uses APP_ADMIN_EMAIL / APP_ADMIN_PASSWORD from local.app.secrets.env.
APP_URL=http://localhost:4200
# The host API behind it. Tests that post Twilio webhooks call it directly; they skip when it
# still validates Twilio signatures (EnvironmentSetting Twilio:ValidateSignature).
APP_API_URL=https://localhost:7026
# The host's EnvironmentSetting TimeZoneSettings:TimeZoneId ("Central Standard Time"), as the tests' own oracle for expected times.
APP_TIME_ZONE=America/Chicago
# The host API's local database, used only by tests that seed their own rows (Windows auth via sqlcmd).
LOCAL_SQL_SERVER=Kawsar-Ahmed\SQLEXPRESS
LOCAL_SQL_DATABASE=QuarryConnect_Dev
# Identity's local database (same server), used only by the password-grant tests to toggle and restore the test driver.
IDENTITY_SQL_DATABASE=QuarryConnect_Identity_Dev
# HOST_MASTER (same server), used by the mirror tests (QC-737) to read the copied rows and point a host at an unreachable API.
MASTER_SQL_DATABASE=QuarryConnect_Master_Dev

# The drivers API and the mobile client that uses the password grant (QC-706). Tests that need either skip when it is unset.
DRIVERS_API_URL=https://localhost:7076
MOBILE_CLIENT_ID=drivers.mobile.local
# Two host clients that belong to different Identity hosts (app.HostClients), for the host-mapping tests (QC-725).
# The redirect URIs must match the clients' registration exactly; the tests catch the redirect, so nothing has to listen there.
HOST_CLIENT_ID=host.local
HOST_REDIRECT_URI=http://localhost:4200/
SECOND_HOST_CLIENT_ID=host.local2
SECOND_HOST_REDIRECT_URI=http://localhost:4201/
# The Driver UI's code-flow client (QC-665 host selection). Nothing has to listen on the redirect URI; the tests catch the redirect.
DRIVER_UI_CLIENT_ID=drivers.local
DRIVER_UI_REDIRECT_URI=http://localhost:4300/
# Identity's administration API (QC-738): the client-credentials service client seeded by
# quarryconnect-identity/sql/seeds/001_bootstrap_identity.sql. Its secret is ADMIN_API_CLIENT_SECRET in local.secrets.env.
ADMIN_API_CLIENT_ID=identity.admin.service
# Identity's log folder. With no mail server, Identity logs account-email links here in Development; PWD-14 reads its reset link from it.
IDENTITY_LOG_DIR=../quarryconnect-identity/QuarryConnect.Identity/logs

# Local data is disposable, so writes are on. Each write test restores what it changes.
ALLOW_WRITES=true
# Creating hosts leaves rows in HOST_MASTER (there is no delete), so it stays opt-in.
ALLOW_CREATE_HOSTS=false
# A host API started with `dotnet run` does not come back after a restart, so this stays opt-in.
ALLOW_RESTART=false
