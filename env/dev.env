# Shared development environment. Fill in the real URLs once the dev deployment exists.
ADMIN_URL=https://admin-dev.quarryconnect.com
# The Admin API behind the Angular Admin (quarryconnect-admin-ui src/environments/environment.ts).
ADMIN_API_URL=https://admin-devapi.quarryconnect.com
IDENTITY_URL=https://id-dev.quarryconnect.com
HOST_NAME=Rock Ridge Transport
IGNORE_HTTPS_ERRORS=false

# Dev is shared: read-only by default. Opt in per run with ALLOW_WRITES=true.
ALLOW_WRITES=false
ALLOW_CREATE_HOSTS=false
ALLOW_RESTART=false
