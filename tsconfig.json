{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": "."
  },
  "include": ["playwright.config.ts", "config/**/*.ts", "pages/**/*.ts", "fixtures/**/*.ts", "tests/**/*.ts"]
}
